{
  "manifest_version": 1,
  "version": 6,
  "type": "APP",
  "desktop": {
    "js": [
      "https://unpkg.com/kintone-ui-component/umd/kuc.min.js",
      "js/common.js",
      "js/desktop.js"
    ],
    "css": [
      "https://unpkg.com/kintone-ui-component/umd/kuc.min.css", 
      "css/51-modern-default.css",
      "css/desktop.css"
    ]
  },
  "icon": "image/icon.png",
  "config": {
    "html": "html/config.html",
    "js": [
      "https://unpkg.com/kintone-ui-component/umd/kuc.min.js",
      "js/common.js",
      "js/config.js"
    ],
    "css": [
      "https://unpkg.com/kintone-ui-component/umd/kuc.min.css", 
      "css/51-modern-default.css",
      "css/config.css"
    ],
    "required_params": [
      "apiKeyConfigured",
      "model",
      "contentField",
      "replyField",
      "spaceId"
    ]
  },
  "name": {
    "en": "Kintone Text Generation Plugin (OpenAI)",
    "ja": "kintone テキスト生成プラグイン（OpenAI対応版）"
  },
  "description": {
    "en": "A plugin that uses the OpenAI Responses API to generate text and write it to specified fields in kintone.",
    "ja": "OpenAI Responses APIを使ってテキストを生成し、kintoneの指定フィールドに書き込むプラグイン"
  },
  "mobile": {
    "js": [
      "https://unpkg.com/kintone-ui-component/umd/kuc.min.js",
      "js/common.js",
      "js/mobile.js"
    ],
    "css": [
      "https://unpkg.com/kintone-ui-component/umd/kuc.min.css", 
      "css/mobile.css"
    ]
  }
}
